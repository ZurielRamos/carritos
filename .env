# Número de WhatsApp con código de país, sin "+" ni espacios (ej: 573001234567)
# Después de editar este archivo, reinicia `npm run dev`.
VITE_WHATSAPP_NUMBER=573145058570

# URL pública del sitio, sin "/" al final. Se usa en la imagen al compartir (Open Graph).
# Cámbiala por tu dominio real al publicar.
VITE_SITE_URL=https://carritos-weld.vercel.app

# Menú desde Google Sheets (opcional). Pega aquí el enlace CSV de la hoja publicada:
# Archivo > Compartir > Publicar en la web > (hoja) > formato CSV > Publicar.
# Si queda vacío, el menú sale de src/data/products.json.
VITE_SHEET_CSV_URL=
